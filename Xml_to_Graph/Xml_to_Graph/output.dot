digraph G {
    graph[fontsize = 24]
    edge[fontsize = 20 color = darkgoldenrod1]
    node[margin=0 fontcolor=cornsilk fontsize=48 width=0.5 shape=circle style=filled fillcolor = blue2]
    ranksep = 1.5
    nodesep = .25
    edge[style = "setlinewidth(3)"]
    1 -> 2;
    1 -> 4;
    2 -> 3;
    2 -> 4;
    3 -> 2;
    4 -> 1;
    4 -> 3;
}
